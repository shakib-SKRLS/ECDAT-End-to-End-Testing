# ECDAT environment configuration
# Copy to .env and adjust as needed.

# sqlite (local default) or postgresql
ECDAT_DATABASE_URL=sqlite:///./data/ecdat.db
# ECDAT_DATABASE_URL=postgresql+psycopg://ecdat:ecdat@localhost:5432/ecdat

ECDAT_HOST=0.0.0.0
ECDAT_PORT=8000
ECDAT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Restrict filesystem scans to these roots (comma-separated). Empty = workspace + sample-data only.
ECDAT_ALLOWED_SCAN_ROOTS=

# Quantum-threat horizon assumption (years). Configurable; NOT a prediction.
ECDAT_QUANTUM_THREAT_HORIZON_YEARS=10

# Default Mosca inputs when project does not override them
ECDAT_DEFAULT_DATA_LIFETIME_YEARS=5
ECDAT_DEFAULT_MIGRATION_TIME_YEARS=3

ECDAT_MAX_SCAN_FILES=20000
ECDAT_MAX_FILE_BYTES=1048576
ECDAT_SCAN_WORKERS=8
ECDAT_GIT_CLONE_TIMEOUT_SECONDS=120

# Frontend API base (used at build time in Docker)
VITE_API_BASE_URL=

# Clone root for git sources (see backend/app/core/config.py)
ECDAT_CLONE_ROOT=./data/clones

ECDAT_LOG_LEVEL=INFO
